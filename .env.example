# -----------------------------------------------------------------------------
# Copiez ce fichier vers `.env` et renseignez les deux valeurs.
# Elles se trouvent dans le tableau de bord Supabase : Project Settings → API.
#
# Vite n'expose au navigateur que les variables préfixées par VITE_.
# La clé `anon` est publique par conception : c'est la RLS, définie dans
# supabase/migrations/0002_rls.sql, qui protège les données.
# N'utilisez JAMAIS la clé `service_role` ici.
# -----------------------------------------------------------------------------

# L'URL utilise la RÉFÉRENCE du projet (suite de lettres), pas son nom.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique
